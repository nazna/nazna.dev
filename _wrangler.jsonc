{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nazna-dev",
  "main": "./src/main.ts",
  "compatibility_date": "2026-05-31",
  "workers_dev": false,
  "preview_urls": false,
  "route": {
    "pattern": "nazna.dev",
    "custom_domain": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "bucket_name": "nazna-dev",
      "binding": "STORAGE",
      "remote": true,
    },
  ],
}
